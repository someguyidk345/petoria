title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;

// Keep family dissatisfaction and influence within valid bounds.
var family_influence_total = 0;
var family_dissent_total = 0;
for (var family_member of Q.factions) {
    if (Q[family_member + '_dissent'] < 0) {
        Q[family_member + '_dissent'] = 0;
    } else if (Q[family_member + '_dissent'] > 100) {
        Q[family_member + '_dissent'] = 100;
    }
    if (Q[family_member + '_strength'] < 0) {
        Q[family_member + '_strength'] = 0;
    }
    family_influence_total += Q[family_member + '_strength'];
    family_dissent_total += Q[family_member + '_strength'] * Q[family_member + '_dissent'];
}

if (family_influence_total > 0) {
    Q.dissent = family_dissent_total / (family_influence_total * 100);
} else {
    Q.dissent = 0;
}
if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}
Q.dissent_percent = Q.dissent * 100;

// Advance the calendar and decay family unity once per in-game month.
if (Q.month_actions >= 1) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.month += 1;
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
        if (Q.annual_income > 0) {
            Q.resources += Q.annual_income;
        }
    }

    // Family unity loses a small amount each month, proportional to overall dissent.
    Q.family_unity -= Q.dissent_percent / 100;
    if (Q.family_unity < 0) {
        Q.family_unity = 0;
    } else if (Q.family_unity > 100) {
        Q.family_unity = 100;
    }

    for (var timer of Q.timers) {
        if (Q[timer + '_timer'] && Q[timer + '_timer'] > 0) {
            Q[timer + '_timer'] -= 1;
        }
    }
}
Q.has_event = 0;
// check if there are any Petoria events, and then go to main if not.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
} else {
    has_event = 0;
}
// pre-load all of the event images
if (this.ui && this.ui.show_portraits) {
    for (var choice of choices) {
        var cc = this.game.scenes[choice.id];
        if (cc.faceImage) {
            var im = new Image();
            im.url = cc.faceImage;
        }
    }
}

if (typeof window !== "undefined" && window.generateBar) {
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0 and (difficulty = 0 or difficulty = 1 or hand_size == 3); main.main_easy if has_event = 0 and (difficulty < 0 or hand_size == 4)

= [+ month : month +] [+ year +]

@events_choice


# This scene is solely for updating numbers after events, and routing to special events.
