title: Petoria — State Affairs
set-bg: img/map_2.jpg
is-hand: true
max-cards: 4
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Family advisors — an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Family advisors — next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Family advisors — next action available in ' + Q.advisor_action_timer + ' months.';
}
!}

= Family

Internal dissent: [+ dissent_percent +]%
Family unity: [+ family_unity +]%

